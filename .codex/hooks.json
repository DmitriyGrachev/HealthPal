{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/privacy-scan.ps1')\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/privacy-scan.ps1')\"",
            "timeout": 30,
            "statusMessage": "Scanning changed files for secrets and privacy leaks"
          }
        ]
      }
    ]
  }
}
